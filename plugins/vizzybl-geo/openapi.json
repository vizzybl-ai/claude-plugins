    "/prompts/{promptId}/scrape": {
      "post": {
        "summary": "Trigger a fresh scrape of a prompt across AI engines (async; 202). Charges prompt_monitor_run.",
        "x-required-scope": "write:prompts",
        "responses": {
          "200": {
            "description": "OK"
          },
          "202": {
            "description": "Accepted — async; poll the matching GET"
          },
          "400": {
            "description": "Invalid parameter, or a disallowed audit URL (BLOCKED)"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "402": {
            "$ref": "#/components/responses/InsufficientCredits"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "parameters": [
          {
            "name": "promptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "engines": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "chatgpt",
                        "gemini",
                        "claude",
                        "perplexity",
                        "grok",
                        "google_aio",
                        "google_ai_mode",
                        "copilot"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "x-charges-credits": true
      }
    }
  }
}
