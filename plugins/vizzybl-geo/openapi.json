    "/audits/{auditId}": {
      "get": {
        "summary": "GEO audit status and scores for polling.",
        "x-required-scope": "read:brand",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
